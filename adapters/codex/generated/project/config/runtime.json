  "notes": "Planning values are not Host facts. Unknown capacity is serial. Native role binding and hook coverage require independent runtime evidence; same-permission agents are not OS isolated.",
  "competition_file": "config/contest-mcm-2027.json",
  "run_mode": "preparation",
  "freeze_hours_before_stop": {
    "model": 18,
    "results": 10,
    "paper": 2
  },
  "default_programmer_instances": 2,
  "programmer_specialties": [
    "solver",
    "pipeline_and_experiments"
  ],
  "optional_code_lead": true,
  "code_lead_enabled_by_default": false,
