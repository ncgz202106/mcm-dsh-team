      "data/processed",
      "tasks"
    ],
    "mcm-programmer": [
      "src",
      "results",
      "example",
      "paper/generated",
      "tasks",
      "experiments"
    ],
    "mcm-verifier": [
      "audit/verification",
      "reviews/verification",
      "tasks"
    ],
    "mcm-paper-lead": [
      "paper",
      "tasks"
    ],
    "mcm-writer": [
      "tasks"
    ],
    "mcm-figure": [
      "figures",
      "tasks"
    ],
    "mcm-typesetter": [
      "paper/styles",
